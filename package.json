{
  "name": "css-cleaner",
  "version": "0.1.0",
  "description": "CLI locale d’audit des classes CSS pour React",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "packageManager": "pnpm@11.25.0",
  "bin": {
    "css-cleaner": "./dist/cli/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "pnpm run build && tsc --project tsconfig.test.json && node --test .test-dist/tests/*.test.js",
    "prepack": "pnpm run build"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "@types/picomatch": "4.0.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dokor/css-cleaner.git"
  },
  "dependencies": {
    "picomatch": "4.0.7",
    "postcss": "8.5.31",
    "postcss-selector-parser": "7.1.7",
    "sass-parser": "0.5.3",
    "typescript": "5.9.3"
  }
}
